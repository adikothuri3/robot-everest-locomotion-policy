# Optional environment configuration (copy to .env; nothing here is required)

# Weights & Biases (Holosoma logger:wandb). Leave unset to use TensorBoard only.
# WANDB_API_KEY=

# Override the asset root the Holosoma extension uses (defaults to the /mnt/c
# path of this repo inside WSL2).
# EVEREST_A3_ASSET_ROOT=/home/<user>/a3_assets
