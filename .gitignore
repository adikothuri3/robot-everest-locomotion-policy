# Obsidian per-machine UI state; the rest of notes/.obsidian IS tracked
notes/.obsidian/workspace.json
notes/.obsidian/workspace-mobile.json

__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
.pytest_cache/
.env

# Training runs stay out of git: .pt states are ~18 MB each and tfevents logs
# reach 56 MB. The SHIPPED policies are the exception — the final .onnx of each
# run plus its holosoma_config.yaml are force-added (`git add -f`) so colleagues
# can run the sim2sim gate from a plain clone. Tracked files ignore this rule
# once added; see README "Shipped policies".
checkpoints/
results/
experiments/*/runs/
wandb/
outputs/

third_party/*/
!third_party/README.md

*.usd
*.usda
# holosoma's IsaacSim URDF->USD cache is written as converted_rank<N>/
assets/**/converted*/

.DS_Store
Thumbs.db
